# ==============================================================================
# RAG Search Orchestrator - Environment Configuration
# Copy this file to `.env` for local development and adjust values as needed.
#
# NOTE: `.env` is for LOCAL DEVELOPMENT ONLY.
# Only changes to `.env.prod` affect `deployments/` (synced via
# `python scripts/sync_env_to_deployments.py --sync`).
#
# Process-level environment variables (e.g., Kubernetes env/Secrets) always
# take precedence over values defined in `.env`.
# ==============================================================================

# --- Go Runtime Memory & GC Tuning (Production: 4Gi pod limit) ----------------
GOMEMLIMIT=3600MiB
GOGC=100

# --- Inbound Transport & Server Lifecycle -------------------------------------
HTTP_ADDR=:8080
GRPC_ADDR=:50051
SHUTDOWN_DRAIN_DELAY=5s
LOG_LEVEL=info

# --- Redis 7.2 Cluster (Tier 1 Query Cache & Parent Chunk Hydration) ----------
# Comma-separated list of Redis Cluster or standalone node addresses.
REDIS_ADDRS=localhost:6379
# Leave empty for unauthenticated local Redis; inject via Secret in production.
REDIS_PASSWORD=
CACHE_TTL=5m

# --- Parallel Multi-Index Search Fan-Out (20ms hard deadline) -----------------
# Comma-separated gRPC targets for dense HNSW replicas and sparse BM25 shards.
HNSW_TARGETS=localhost:50052
BM25_TARGETS=localhost:50053
GRPC_POOL_SIZE=4

# --- Triton Inference Server (FP16 Embedding & Cross-Encoder Reranker) --------
TRITON_EMBED_TARGETS=localhost:8001
TRITON_RERANK_TARGETS=localhost:8001
TRITON_EMBED_MODEL=bge-m3-fp16
TRITON_RERANK_MODEL=bge-reranker-cross-encoder
# Optional Triton model version; leave empty to use the latest active version.
TRITON_RERANK_VERSION=
# Minimum Cross-Encoder logit threshold (tau); below tau falls back to RRF.
RERANK_TAU=0.0

# --- Zero-Alloc Compliance Telemetry ------------------------------------------
# Lock-free MPSC ring buffer capacity (positive integer, power of 2 recommended).
RING_BUFFER_CAPACITY=8192
